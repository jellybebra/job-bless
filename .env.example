# Generate .env with python scripts/configure_server.py
# Published by .github/workflows/docker.yml; use one tag for all three images.
JOB_BLESS_IMAGE_PREFIX=ghcr.io/yn9m/job-bless
JOB_BLESS_IMAGE_TAG=latest
WEB_PASSWORD_HASH=
AISTUDIO_SERVICE_KEY=
COMPOSE_PROFILES=google
# Optional outbound proxy for Google. Docker Desktop + v2rayN:
# GOOGLE_PROXY_URL=http://host.docker.internal:10808
GOOGLE_PROXY_URL=
WEB_BIND=127.0.0.1
WEB_PORT=8080
JOB_BLESS_DATA_PATH=./data/server
# For the HTTPS server overlay:
SITE_DOMAIN=
